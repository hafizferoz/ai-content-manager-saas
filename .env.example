# Copy to .env for local development. Never commit .env or real secrets.
APP_ENV=local
APP_NAME=AI Content Manager
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1

# Local Docker defaults only
POSTGRES_DB=content_manager
POSTGRES_USER=content_manager
POSTGRES_PASSWORD=change-me-local-only
AUTO_CREATE_SCHEMA=false
DATABASE_URL=postgresql+psycopg://content_manager:change-me-local-only@localhost:5432/content_manager
REDIS_URL=redis://localhost:6379/0

# Optional object storage; configure when uploads are implemented
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=content-manager-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-local-only

# Configure only after selecting an auth provider
AUTH_SECRET=replace-with-a-long-random-value
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# AI provider; keep secrets server-side
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

# Social integrations: leave empty to use mock adapter
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOG_LEVEL=INFO
PUBLISHING_ENABLED=false
USE_MOCK_SOCIAL_ADAPTER=true
